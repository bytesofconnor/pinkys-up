# Resend email service configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Email address to send quote notifications FROM
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=Pinkys Up <onboarding@resend.dev>

# Email address to receive quote notifications (your operations email)
QUOTE_NOTIFICATION_EMAIL=

# Optional: Send confirmation email to guests who submit quotes
# Set to "true" to enable, leave empty or set to "false" to disable
SEND_GUEST_CONFIRMATION=false

# Database Configuration (Supabase)
# Get these from your Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin Access
# Set a secure random token to access /admin/quotes?token=YOUR_TOKEN
ADMIN_TOKEN=

# Calendly integration (optional)
NEXT_PUBLIC_CALENDLY_URL=
